{
  "name": "aed-pseudocodigo",
  "displayName": "AED Pseudocódigo (UTN-FRRe)",
  "description": "Resaltado, diagnósticos y ejecución del pseudocódigo de Algoritmos y Estructuras de Datos (UTN-FRRe).",
  "version": "0.11.0",
  "publisher": "gonzalo",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1E202C",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Education"
  ],
  "keywords": [
    "pseudocodigo",
    "pseudocódigo",
    "aed",
    "utn",
    "frre",
    "algoritmos",
    "estructuras de datos",
    "espanol"
  ],
  "qna": false,
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "aed-pseudocodigo",
        "aliases": [
          "Pseudocódigo AED",
          "aed"
        ],
        "extensions": [
          ".frre",
          ".pseudo",
          ".aed"
        ],
        "firstLine": "^\\s*(//.*|#.*)?\\s*[Aa][Cc][Cc][Ii][OoÓó][Nn]\\b",
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "aed-pseudocodigo",
        "scopeName": "source.aed",
        "path": "./syntaxes/aed.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "aed.run",
        "title": "Ejecutar pseudocódigo AED",
        "category": "AED",
        "icon": "$(play)"
      },
      {
        "command": "aed.usarLenguaje",
        "title": "Usar pseudocódigo AED en este archivo",
        "category": "AED"
      },
      {
        "command": "aed.generarDatos",
        "title": "Generar plantilla de datos",
        "category": "AED",
        "icon": "$(new-file)"
      }
    ],
    "keybindings": [
      {
        "command": "aed.run",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "when": "editorTextFocus && editorLangId == aed-pseudocodigo"
      },
      {
        "command": "aed.run",
        "key": "ctrl+f5",
        "mac": "cmd+f5",
        "when": "editorTextFocus && editorLangId == aed-pseudocodigo"
      },
      {
        "command": "aed.run",
        "key": "f5",
        "when": "editorTextFocus && editorLangId == aed-pseudocodigo && !inDebugMode"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "aed.run",
          "when": "editorLangId == aed-pseudocodigo",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "aed.run",
          "when": "editorLangId == aed-pseudocodigo",
          "group": "aed@1"
        },
        {
          "command": "aed.generarDatos",
          "when": "editorLangId == aed-pseudocodigo",
          "group": "aed@2"
        }
      ],
      "explorer/context": [
        {
          "command": "aed.run",
          "when": "resourceExtname == .frre || resourceExtname == .pseudo || resourceExtname == .aed",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "aed.run",
          "when": "editorLangId == aed-pseudocodigo"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc --noEmit -p tsconfig.json && node build.mjs",
    "watch": "node build.mjs --watch",
    "test": "node --import tsx --test test/*.test.ts",
    "test:vscode": "node build.mjs && vscode-test",
    "package": "npm run compile && npx --yes @vscode/vsce package --no-dependencies",
    "check:resaltado": "node scripts/tm-check.cjs ejemplos/demo.frre",
    "aed": "node --import tsx scripts/aed.ts"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.20.0",
    "mocha": "^12.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}