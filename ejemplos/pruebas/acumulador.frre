ACCION ejemplo ES
    AMBIENTE
        a: LOGICO
        b,s: ENTERO
        cont: AN(1)
    PROCESO
        a:= VERDADERO
        s:=0
        MIENTRAS A = VERDADERO HACER
            ESCRIBIR("Ingresar un numero")
            LEER(b)
            s:=s+b
            ESCRIBIR("Desea continuar? S/N")
            LEER(cont)
            SI cont = "s" O cont = "S" ENTONCES
                a:= VERDADERO
            SINO 
                a := FALSO
            FIN_SI
        FIN_MIENTRAS
        ESCRIBIR(s)
FIN_ACCION
