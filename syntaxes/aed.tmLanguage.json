{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Pseudocódigo AED",
  "scopeName": "source.aed",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#structure" },
    { "include": "#control" },
    { "include": "#io" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.aed", "match": "//.*$" },
        { "name": "comment.line.number-sign.aed", "match": "#.*$" },
        { "name": "comment.block.aed", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "patterns": [
        { "name": "string.quoted.double.aed", "begin": "\"", "end": "\"" },
        { "name": "string.quoted.single.aed", "begin": "'", "end": "'" }
      ]
    },
    "numbers": {
      "patterns": [{ "name": "constant.numeric.aed", "match": "\\b[0-9]+(\\.[0-9]+)?\\b" }]
    },
    "structure": {
      "patterns": [
        {
          "name": "keyword.other.structure.aed",
          "match": "(?i)\\b(ACCI[OÓ]N|FIN_ACCI[OÓ]N|FINACCI[OÓ]N|AMBIENTE|PROCESO|ALGORITMO|FIN_PROCESO|FUNCI[OÓ]N|FIN_FUNCI[OÓ]N|FINFUNCI[OÓ]N|PROCEDIMIENTO|FIN_PROCEDIMIENTO|FINPROCEDIMIENTO|FIN_PROC|FINPROC|REGISTRO|FIN_REGISTRO|FINREGISTRO|ES|VAR)\\b"
        }
      ]
    },
    "control": {
      "patterns": [
        {
          "name": "keyword.control.aed",
          "match": "(?i)\\b(SI|ENTONCES|SINO|CONTRARIO|FIN_SI|FINSI|SEG[UÚ]N|FIN_SEG[UÚ]N|FINSEG[UÚ]N|OTROS|MIENTRAS|FIN_MIENTRAS|FINMIENTRAS|REPETIR|HASTA|QUE|PARA|FIN_PARA|FINPARA|HACER)\\b"
        }
      ]
    },
    "io": {
      "patterns": [
        {
          "name": "support.function.io.aed",
          "match": "(?i)\\b(ESCRIBIR|ESC|GRABAR|LEER|ABRIR|CERRAR|RE-ESCRIBIR|REESCRIBIR|ELIMINAR|ARR|AVZ|CREAR|N?FDA|NOFDA|N?FDS|NOFDS|EXISTE|ABSO)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.aed",
          "match": "(?i)\\b(ENTERO|REAL|CAR[AÁ]CTER|L[OÓ]GICO|ALFANUM[EÉ]RICO|ARREGLO|ARCHIVO|SECUENCIA|INDEXADO|ORDENADO|POR|DE|AN|N)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [{ "name": "constant.language.aed", "match": "(?i)\\b(VERDADERO|FALSO)\\b" }]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.logical.aed", "match": "(?i)\\b(Y|O|NO|EN|MOD|DIV)\\b" },
        { "name": "keyword.operator.assignment.aed", "match": ":=" },
        { "name": "keyword.operator.comparison.aed", "match": "(<>|>=|<=|=|<|>)" },
        { "name": "keyword.operator.arithmetic.aed", "match": "(\\*\\*|[-+*/])" }
      ]
    }
  }
}
